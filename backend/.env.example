# Django Settings
SECRET_KEY=django-insecure-example-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database URL
# Format: postgresql://user:password@hostname:5432/dbname
# Leave blank for local SQLite fallback or provide a PostgreSQL connection URL
DATABASE_URL=postgresql://taskuser:taskpassword@localhost:5432/taskdb

# CORS Config (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
